# Supabase (https://supabase.com)
# 1. Crea un proyecto en supabase.com
# 2. Copia estos valores desde: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
# Solo para el servidor (Settings > API > Service Role key). ¡Nunca la expongas!
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Contraseña para entrar al editor en /admin
EDITOR_PASSWORD=cambia-esta-contrasena
